DirectoryIndex index.php
Options -Indexes

<FilesMatch "^(\.env|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

RewriteEngine On

# Eén voorkeursdomein en HTTPS, zonder lokale XAMPP-ontwikkeling te redirecten.
RewriteCond %{HTTP_HOST} ^www\.ynwebdesign\.nl$ [NC]
RewriteRule ^ https://ynwebdesign.nl%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^ynwebdesign\.nl$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://ynwebdesign.nl%{REQUEST_URI} [R=301,L]

# Voorkom een tweede homepage-URL met dezelfde content.
RewriteCond %{HTTP_HOST} ^ynwebdesign\.nl$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ https://ynwebdesign.nl/ [R=301,L]

RewriteRule ^sitemap\.xml$ sitemap.php [L]
ErrorDocument 404 /404.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
